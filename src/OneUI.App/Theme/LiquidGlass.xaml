<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Core Liquid Glass Palette (calibrated for DWM Hardware Acrylic Backdrop) -->
    <SolidColorBrush x:Key="GlassSurfaceBrush" Color="#4810121A"/>
    <SolidColorBrush x:Key="DockPillSurfaceBrush" Color="#3E12141E"/>
    <SolidColorBrush x:Key="GlassCardBrush" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="GlassCardHoverBrush" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="GlassSidebarBrush" Color="#18000000"/>
    <SolidColorBrush x:Key="GlassTextPrimaryBrush" Color="#FAFFFFFF"/>
    <SolidColorBrush x:Key="GlassTextSecondaryBrush" Color="#A6E6ECFA"/>
    <SolidColorBrush x:Key="GlassTextMutedBrush" Color="#72E6ECFA"/>
    <SolidColorBrush x:Key="GlassDividerBrush" Color="#22FFFFFF"/>
    <SolidColorBrush x:Key="GlassAccentBrush" Color="#FF0A84FF"/>
    <SolidColorBrush x:Key="GlassTooltipBgBrush" Color="#E8151722"/>
    <SolidColorBrush x:Key="GlassMenuBgBrush" Color="#F0181A26"/>

    <!-- Chromatic Specular Rim-Light Border (Apple Liquid Glass signature top-left to bottom-right refraction) -->
    <LinearGradientBrush x:Key="LiquidGlassRimBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#95FFFFFF" Offset="0.0"/>
        <GradientStop Color="#42DCEEFF" Offset="0.25"/>
        <GradientStop Color="#1AFFFFFF" Offset="0.55"/>
        <GradientStop Color="#14FFFFFF" Offset="0.80"/>
        <GradientStop Color="#52E4F0FF" Offset="1.0"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="LiquidGlassOuterRimBrush" Color="#38000000"/>

    <!-- Radial Top-Center Lens Luminance Overlay -->
    <RadialGradientBrush x:Key="LiquidGlassLensGlowBrush" Center="0.5,0.0" GradientOrigin="0.5,0.0" RadiusX="0.75" RadiusY="0.65">
        <GradientStop Color="#24FFFFFF" Offset="0.0"/>
        <GradientStop Color="#0AFFFFFF" Offset="0.55"/>
        <GradientStop Color="#00FFFFFF" Offset="1.0"/>
    </RadialGradientBrush>

    <!-- Subtle top inner glass refraction sheen -->
    <LinearGradientBrush x:Key="LiquidGlassSheenBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#32FFFFFF" Offset="0.0"/>
        <GradientStop Color="#0EFFFFFF" Offset="0.28"/>
        <GradientStop Color="#00FFFFFF" Offset="0.65"/>
        <GradientStop Color="#0CFFFFFF" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Global macOS Liquid Glass ContextMenu & MenuItem Styles -->
    <Style TargetType="ContextMenu">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="HasDropShadow" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{DynamicResource GlassMenuBgBrush}"
                            BorderBrush="{DynamicResource LiquidGlassRimBrush}"
                            BorderThickness="1"
                            CornerRadius="11"
                            Padding="5,5"
                            MinWidth="200">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="7" Opacity="0.48" Color="Black"/>
                        </Border.Effect>
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource GlassTextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Padding" Value="11,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            Margin="1,1">
                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#D80A84FF"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="9,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{DynamicResource GlassDividerBrush}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Menu Bar / Inline Pill Button -->
    <Style x:Key="GlassPillButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource GlassTextPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="5"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#24FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#38FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Liquid Glass Bento Card Button -->
    <Style x:Key="GlassTileButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource GlassCardBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource GlassTextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LiquidGlassRimBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="11,9"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GlassCardHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.82"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sidebar Navigation Item Button -->
    <Style x:Key="SidebarNavButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource GlassTextPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#20FFFFFF"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="Selected">
                            <Setter TargetName="Bd" Property="Background" Value="#380A84FF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- macOS-style Pill Toggle Switch -->
    <Style x:Key="MacToggleSwitch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Width="40" Height="22">
                        <Border x:Name="Track"
                                CornerRadius="11"
                                Background="#30FFFFFF"
                                BorderBrush="#3AFFFFFF"
                                BorderThickness="1"/>
                        <Ellipse x:Name="Knob"
                                 Width="16" Height="16"
                                 Fill="White"
                                 HorizontalAlignment="Left"
                                 Margin="3,0,0,0">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.32"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="#FF30D158"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="#55FFFFFF"/>
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- macOS Control Center Thick Capsule Slider -->
    <Style x:Key="MacGlassSlider" TargetType="Slider">
        <Setter Property="Height" Value="24"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border Height="22"
                                CornerRadius="11"
                                Background="#24000000"
                                BorderBrush="#35FFFFFF"
                                BorderThickness="1"/>
                        <Track x:Name="PART_Track" Height="22">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="22" CornerRadius="11,0,0,11" Background="#EEFFFFFF"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="22" Height="22">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Fill="White" Stroke="#25000000" StrokeThickness="0.6">
                                                <Ellipse.Effect>
                                                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.35"/>
                                                </Ellipse.Effect>
                                            </Ellipse>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
