<Window x:Class="OneUI.App.Views.ControlCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick Settings"
        Width="352"
        SizeToContent="Height"
        Topmost="True"
        ShowInTaskbar="False"
        Background="Transparent"
        Deactivated="Window_Deactivated"
        KeyDown="Window_KeyDown">

    <Border x:Name="RootCard"
            Background="{DynamicResource GlassSurfaceBrush}"
            BorderBrush="{DynamicResource LiquidGlassRimBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="14">
        <StackPanel>
            <!-- Row 0: Authentic Asymmetric Bento Grid (Connectivity Left Card + Mode/Toggles Right Stack) -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Tall Card: Wi-Fi + Bluetooth -->
                <Border Grid.Column="0"
                        Background="{DynamicResource GlassCardBrush}"
                        BorderBrush="{DynamicResource LiquidGlassRimBrush}"
                        BorderThickness="1"
                        CornerRadius="13"
                        Padding="10,8">
                    <StackPanel VerticalAlignment="Center">
                        <Button Style="{StaticResource GlassPillButton}" Click="NetworkTile_Click" HorizontalContentAlignment="Left" Padding="4,5">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="NetworkBadge" Width="30" Height="30" CornerRadius="15" Background="#FF0A84FF" Margin="0,0,10,0">
                                    <TextBlock Text="&#xE701;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="White" FontSize="13.5"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Wi-Fi" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource GlassTextPrimaryBrush}"/>
                                    <TextBlock x:Name="NetworkStatusLabel" Text="Connected" FontSize="10.5" Foreground="{DynamicResource GlassTextSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource GlassPillButton}" Click="BluetoothTile_Click" HorizontalContentAlignment="Left" Padding="4,5" Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="30" Height="30" CornerRadius="15" Background="#FF0A84FF" Margin="0,0,10,0">
                                    <TextBlock Text="&#xE702;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="White" FontSize="13.5"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Bluetooth" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource GlassTextPrimaryBrush}"/>
                                    <TextBlock Text="Devices" FontSize="10.5" Foreground="{DynamicResource GlassTextSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Right Column: Liquid Glass Theme + 2 Mini Feature Tiles -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" Style="{StaticResource GlassTileButton}" Click="ThemeTile_Click" HorizontalContentAlignment="Left" Padding="10,8">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="28" Height="28" CornerRadius="14" Background="#FF5E5CE6" Margin="0,0,9,0">
                                <TextBlock x:Name="ThemeIcon" Text="&#xE708;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="White" FontSize="13"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Appearance" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource GlassTextPrimaryBrush}"/>
                                <TextBlock x:Name="ThemeStatusLabel" Text="Dark Glass" FontSize="10.5" Foreground="{DynamicResource GlassTextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Style="{StaticResource GlassTileButton}" Click="TaskbarTile_Click" Padding="6,7">
                            <StackPanel HorizontalAlignment="Center">
                                <Border x:Name="TaskbarDot" Width="22" Height="22" CornerRadius="11" Background="#FF30D158" Margin="0,0,0,3">
                                    <TextBlock Text="&#xE75B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Taskbar" FontSize="10.5" FontWeight="Medium" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2" Style="{StaticResource GlassTileButton}" Click="DockAutoHideTile_Click" Padding="6,7">
                            <StackPanel HorizontalAlignment="Center">
                                <Border x:Name="AutoHideDot" Width="22" Height="22" CornerRadius="11" Background="#FF0A84FF" Margin="0,0,0,3">
                                    <TextBlock Text="&#xE740;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Auto-Hide" FontSize="10.5" FontWeight="Medium" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Row 1: Glass Translucency Live Slider Card -->
            <Border Background="{DynamicResource GlassCardBrush}"
                    BorderBrush="{DynamicResource LiquidGlassRimBrush}"
                    BorderThickness="1"
                    CornerRadius="13"
                    Padding="12,9"
                    Margin="0,0,0,10">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="Glass &amp; Transparency" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource GlassTextPrimaryBrush}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource GlassPillButton}" Padding="7,1" Margin="0,0,6,0" Click="GlassBlurToggle_Click" ToolTip="Switch between Frosted Blur and Clear Transparency">
                                <TextBlock x:Name="GlassBlurModeText" Text="Frosted" FontSize="10.5" Foreground="{DynamicResource GlassTextPrimaryBrush}"/>
                            </Button>
                            <TextBlock x:Name="GlassPercentText" Text="30%" FontSize="11" Foreground="{DynamicResource GlassTextSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <Slider x:Name="GlassSlider"
                            Style="{StaticResource MacGlassSlider}"
                            Minimum="0"
                            Maximum="75"
                            ValueChanged="GlassSlider_ValueChanged"/>
                </StackPanel>
            </Border>

            <!-- Row 2: Sound Master Volume Card -->
            <Border Background="{DynamicResource GlassCardBrush}"
                    BorderBrush="{DynamicResource LiquidGlassRimBrush}"
                    BorderThickness="1"
                    CornerRadius="13"
                    Padding="12,9"
                    Margin="0,0,0,10">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="Sound" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource GlassTextPrimaryBrush}"/>
                        <Button HorizontalAlignment="Right" Style="{StaticResource GlassPillButton}" Padding="6,1" Click="MuteToggle_Click">
                            <TextBlock x:Name="VolumePercentText" Text="50%" FontSize="11" Foreground="{DynamicResource GlassTextSecondaryBrush}"/>
                        </Button>
                    </Grid>
                    <Slider x:Name="VolumeSlider"
                            Style="{StaticResource MacGlassSlider}"
                            Minimum="0"
                            Maximum="100"
                            ValueChanged="VolumeSlider_ValueChanged"/>
                </StackPanel>
            </Border>

            <!-- Row 3: Now Playing Media Card -->
            <Border Background="{DynamicResource GlassCardBrush}"
                    BorderBrush="{DynamicResource LiquidGlassRimBrush}"
                    BorderThickness="1"
                    CornerRadius="13"
                    Padding="12,9"
                    Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Margin="0,0,10,0" ClipToBounds="True">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FFFF375F" Offset="0"/>
                                <GradientStop Color="#FFBF5AF2" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <TextBlock x:Name="MediaFallbackIcon" Text="&#xE8D6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="White" FontSize="15"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image x:Name="MediaArtImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock x:Name="MediaTitleText" Text="Nothing Playing" FontWeight="SemiBold" FontSize="12"
                                   Foreground="{DynamicResource GlassTextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="MediaArtistText" Text="Play media to see it here" FontSize="10.5"
                                   Foreground="{DynamicResource GlassTextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource GlassPillButton}" Padding="6,5" Click="MediaPrev_Click" ToolTip="Previous Track">
                            <TextBlock Text="&#xE892;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"/>
                        </Button>
                        <Button Style="{StaticResource GlassPillButton}" Padding="7,5" Click="MediaPlayPause_Click" ToolTip="Play / Pause">
                            <TextBlock x:Name="MediaPlayPauseIcon" Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13.5"/>
                        </Button>
                        <Button Style="{StaticResource GlassPillButton}" Padding="6,5" Click="MediaNext_Click" ToolTip="Next Track">
                            <TextBlock Text="&#xE893;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Row 4: Visual CPU & Memory Telemetry Progress Card -->
            <Border Background="{DynamicResource GlassCardBrush}"
                    BorderBrush="{DynamicResource LiquidGlassRimBrush}"
                    BorderThickness="1"
                    CornerRadius="13"
                    Padding="12,9"
                    Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="CPU" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource GlassTextSecondaryBrush}"/>
                            <TextBlock x:Name="CpuText" Text="0%" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource GlassTextPrimaryBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Border Height="5" CornerRadius="2.5" Background="#26FFFFFF">
                            <Border x:Name="CpuBar" HorizontalAlignment="Left" Width="10" CornerRadius="2.5" Background="#FF0A84FF"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Memory" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource GlassTextSecondaryBrush}"/>
                            <TextBlock x:Name="RamText" Text="0%" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource GlassTextPrimaryBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Border Height="5" CornerRadius="2.5" Background="#26FFFFFF">
                            <Border x:Name="RamBar" HorizontalAlignment="Left" Width="10" CornerRadius="2.5" Background="#FF30D158"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Row 5: Quick Action Pills -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource GlassTileButton}" Click="Screenshot_Click" Padding="8,7">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE722;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Capture" FontSize="11.5" FontWeight="Medium"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="2" Style="{StaticResource GlassTileButton}" Click="Preferences_Click" Padding="8,7">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Settings" FontSize="11.5" FontWeight="Medium"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="4" Style="{StaticResource GlassTileButton}" Click="Lock_Click" Padding="8,7">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Lock" FontSize="11.5" FontWeight="Medium"/>
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</Window>
