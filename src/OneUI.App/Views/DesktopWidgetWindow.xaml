<Window x:Class="OneUI.App.Views.DesktopWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop Widget"
        SizeToContent="WidthAndHeight"
        ShowInTaskbar="False"
        ShowActivated="False"
        Background="Transparent"
        MouseLeftButtonDown="Widget_MouseLeftButtonDown"
        MouseLeftButtonUp="Widget_MouseLeftButtonUp">

    <Border x:Name="WidgetBorder"
            Background="{DynamicResource GlassSurfaceBrush}"
            BorderBrush="{DynamicResource LiquidGlassRimBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16,14"
            Cursor="SizeAll">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem x:Name="CustomizeClockMenuItem" Header="Customize Clock..." Click="CustomizeClock_Click" Visibility="Collapsed"/>
                <MenuItem x:Name="ConfigureWeatherMenuItem" Header="Weather Settings..." Click="CustomizeClock_Click" Visibility="Collapsed"/>
                <MenuItem Header="Hide This Widget" Click="HideWidget_Click"/>
                <MenuItem Header="Reset Position" Click="ResetPosition_Click"/>
            </ContextMenu>
        </Border.ContextMenu>

        <Grid>
            <!-- 1. Fully Customizable Clock & Date Widget (Digital / Stacked / Analog) -->
            <StackPanel x:Name="ClockPanel" Visibility="Collapsed" MinWidth="170">
                <!-- Digital Face -->
                <StackPanel x:Name="DigitalClockFace" Visibility="Visible">
                    <StackPanel x:Name="DigitalTimeRow" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <TextBlock x:Name="ClockTimeText"
                                   Text="12:40"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="48"
                                   FontWeight="Light"
                                   Foreground="{DynamicResource GlassTextPrimaryBrush}"
                                   Margin="0,-4,0,0"/>
                        <TextBlock x:Name="ClockSecondsInlineText"
                                   Text=":00"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="20"
                                   FontWeight="Light"
                                   Opacity="0.72"
                                   Foreground="{DynamicResource GlassTextPrimaryBrush}"
                                   VerticalAlignment="Bottom"
                                   Margin="3,0,0,7"/>
                        <TextBlock x:Name="ClockAmPmText"
                                   Text="PM"
                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Opacity="0.75"
                                   Foreground="{DynamicResource GlassTextPrimaryBrush}"
                                   VerticalAlignment="Bottom"
                                   Margin="5,0,0,9"/>
                    </StackPanel>
                </StackPanel>

                <!-- Stacked Lock-Screen Face -->
                <StackPanel x:Name="StackedClockFace" Visibility="Collapsed" HorizontalAlignment="Center">
                    <TextBlock x:Name="StackedHourText"
                               Text="12"
                               FontSize="64"
                               FontWeight="Bold"
                               LineHeight="62"
                               TextAlignment="Center"
                               Foreground="{DynamicResource GlassTextPrimaryBrush}"/>
                    <TextBlock x:Name="StackedMinuteText"
                               Text="40"
                               FontSize="64"
                               FontWeight="Bold"
                               LineHeight="62"
                               Margin="0,-10,0,0"
                               TextAlignment="Center"
                               Opacity="0.88"
                               Foreground="{DynamicResource GlassTextPrimaryBrush}"/>
                    <TextBlock x:Name="StackedSecondsText"
                               Text="00s"
                               FontSize="13"
                               TextAlignment="Center"
                               Opacity="0.70"
                               Margin="0,2,0,0"
                               Foreground="{DynamicResource GlassTextPrimaryBrush}"/>
                </StackPanel>

                <!-- Analog Dial Face -->
                <Grid x:Name="AnalogClockFace" Visibility="Collapsed" Width="156" Height="156" HorizontalAlignment="Center" Margin="4">
                    <Ellipse Stroke="{DynamicResource LiquidGlassRimBrush}" StrokeThickness="1.5" Fill="#1E000000"/>
                    <!-- Hour Markers (12, 3, 6, 9) -->
                    <Border Width="2.5" Height="9" CornerRadius="1" Background="#CCFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0"/>
                    <Border Width="2.5" Height="9" CornerRadius="1" Background="#CCFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
                    <Border Width="9" Height="2.5" CornerRadius="1" Background="#CCFFFFFF" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <Border Width="9" Height="2.5" CornerRadius="1" Background="#CCFFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>

                    <!-- Hour Hand -->
                    <Border x:Name="AnalogHourHand" Width="4" Height="42" CornerRadius="2" Background="White"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-42,0,0"
                            RenderTransformOrigin="0.5,1.0">
                        <Border.RenderTransform>
                            <RotateTransform x:Name="HourHandRotate" Angle="0"/>
                        </Border.RenderTransform>
                    </Border>

                    <!-- Minute Hand -->
                    <Border x:Name="AnalogMinuteHand" Width="2.8" Height="56" CornerRadius="1.4" Background="#EEFFFFFF"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-56,0,0"
                            RenderTransformOrigin="0.5,1.0">
                        <Border.RenderTransform>
                            <RotateTransform x:Name="MinuteHandRotate" Angle="0"/>
                        </Border.RenderTransform>
                    </Border>

                    <!-- Second Hand -->
                    <Border x:Name="AnalogSecondHand" Width="1.5" Height="62" CornerRadius="1" Background="#FFFF9500"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-62,0,0"
                            RenderTransformOrigin="0.5,1.0">
                        <Border.RenderTransform>
                            <RotateTransform x:Name="SecondHandRotate" Angle="0"/>
                        </Border.RenderTransform>
                    </Border>

                    <!-- Center Cap -->
                    <Ellipse Width="8" Height="8" Fill="#FFFF9500" Stroke="White" StrokeThickness="1.2"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <!-- Shared Date Line -->
                <TextBlock x:Name="ClockDateText"
                           Text="Saturday, November 21"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="13"
                           FontWeight="Medium"
                           Opacity="0.82"
                           Margin="0,4,0,0"
                           Foreground="{DynamicResource GlassTextPrimaryBrush}"/>
            </StackPanel>

            <!-- 2. System Monitor Widget -->
            <StackPanel x:Name="SystemPanel" Visibility="Collapsed" Width="230">
                <TextBlock Text="SYSTEM MONITOR"
                           FontSize="10.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource GlassTextSecondaryBrush}"
                           Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,4">
                    <TextBlock Text="CPU" FontSize="12" Foreground="{DynamicResource GlassTextPrimaryBrush}"/>
                    <TextBlock x:Name="SysCpuText" Text="0%" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource GlassTextPrimaryBrush}" HorizontalAlignment="Right"/>
                </Grid>
                <Border Height="6" CornerRadius="3" Background="#28FFFFFF" Margin="0,0,0,10">
                    <Border x:Name="SysCpuBar" HorizontalAlignment="Left" Width="12" CornerRadius="3" Background="#FF0A84FF"/>
                </Border>

                <Grid Margin="0,0,0,4">
                    <TextBlock Text="Memory" FontSize="12" Foreground="{DynamicResource GlassTextPrimaryBrush}"/>
                    <TextBlock x:Name="SysRamText" Text="0 GB" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource GlassTextPrimaryBrush}" HorizontalAlignment="Right"/>
                </Grid>
                <Border Height="6" CornerRadius="3" Background="#28FFFFFF" Margin="0,0,0,10">
                    <Border x:Name="SysRamBar" HorizontalAlignment="Left" Width="12" CornerRadius="3" Background="#FF30D158"/>
                </Border>

                <Grid x:Name="SysBatteryRow">
                    <TextBlock Text="Battery" FontSize="12" Foreground="{DynamicResource GlassTextPrimaryBrush}"/>
                    <TextBlock x:Name="SysBatteryText" Text="100%" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource GlassTextSecondaryBrush}" HorizontalAlignment="Right"/>
                </Grid>
            </StackPanel>

            <!-- 3. Quick Notes Sticky Widget -->
            <StackPanel x:Name="NotesPanel" Visibility="Collapsed" Width="240">
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="QUICK NOTES" FontSize="10.5" FontWeight="SemiBold" Foreground="#FFFFD60A"/>
                    <TextBlock Text="Auto-saved" FontSize="10" Foreground="{DynamicResource GlassTextMutedBrush}" HorizontalAlignment="Right"/>
                </Grid>
                <TextBox x:Name="NotesBox"
                         Height="110"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{DynamicResource GlassTextPrimaryBrush}"
                         CaretBrush="{DynamicResource GlassTextPrimaryBrush}"
                         FontFamily="Segoe UI Variable Text, Segoe UI"
                         FontSize="12.5"
                         Cursor="IBeam"
                         PreviewMouseLeftButtonDown="NotesBox_PreviewMouseLeftButtonDown"
                         TextChanged="NotesBox_TextChanged"/>
            </StackPanel>

            <!-- 4. Media Controls Widget -->
            <StackPanel x:Name="MediaPanel" Visibility="Collapsed" Width="236">
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="9" Margin="0,0,10,0" ClipToBounds="True">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FFFF375F" Offset="0"/>
                                <GradientStop Color="#FFBF5AF2" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <TextBlock x:Name="WidgetMediaFallbackIcon" Text="&#xE8D6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="17" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image x:Name="WidgetMediaArt" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="WidgetMediaTitle" Text="Nothing Playing" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource GlassTextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="WidgetMediaArtist" Text="Play media to see it here" FontSize="11"
                                   Foreground="{DynamicResource GlassTextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>

                <UniformGrid Columns="3">
                    <Button Style="{StaticResource GlassTileButton}" Padding="8,7" Margin="0,0,4,0" Click="MediaPrev_Click">
                        <TextBlock Text="&#xE892;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"/>
                    </Button>
                    <Button Style="{StaticResource GlassTileButton}" Padding="8,7" Margin="2,0" Click="MediaPlayPause_Click">
                        <TextBlock x:Name="WidgetPlayPauseIcon" Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"/>
                    </Button>
                    <Button Style="{StaticResource GlassTileButton}" Padding="8,7" Margin="4,0,0,0" Click="MediaNext_Click">
                        <TextBlock Text="&#xE893;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"/>
                    </Button>
                </UniformGrid>
            </StackPanel>

            <!-- 5. Weather Widget -->
            <StackPanel x:Name="WeatherPanel" Visibility="Collapsed" Width="244">
                <Grid Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE707;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                   Foreground="{DynamicResource GlassTextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock x:Name="WeatherLocationText" Text="Loading..." FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource GlassTextPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="175"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Style="{StaticResource GlassPillButton}" Padding="6,3"
                            Click="WeatherRefresh_Click" ToolTip="Refresh Weather">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"/>
                    </Button>
                </Grid>

                <Grid Margin="0,2,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="WeatherIconText" Text="&#xE706;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="30" Foreground="#FFFFD60A" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock x:Name="WeatherTempText" Text="--°" FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="40" FontWeight="Light" Foreground="{DynamicResource GlassTextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock x:Name="WeatherConditionText" Text="Fetching..." FontSize="12" FontWeight="Medium"
                                   Foreground="{DynamicResource GlassTextPrimaryBrush}" TextAlignment="Right" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="WeatherHighLowText" Text="H:--°  L:--°" FontSize="11"
                                   Foreground="{DynamicResource GlassTextSecondaryBrush}" TextAlignment="Right" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="WeatherFeelsText" Grid.Column="0" Text="Feels --°" FontSize="10.5" Foreground="{DynamicResource GlassTextSecondaryBrush}"/>
                    <TextBlock x:Name="WeatherHumidityText" Grid.Column="1" Text="Hum --%" FontSize="10.5" Foreground="{DynamicResource GlassTextSecondaryBrush}" TextAlignment="Center"/>
                    <TextBlock x:Name="WeatherWindText" Grid.Column="2" Text="-- km/h" FontSize="10.5" Foreground="{DynamicResource GlassTextSecondaryBrush}" TextAlignment="Right"/>
                </Grid>

                <Border Height="1" Background="{DynamicResource GlassDividerBrush}" Margin="0,0,0,8"/>

                <UniformGrid x:Name="WeatherForecastGrid" Columns="3"/>
            </StackPanel>

            <!-- 6. Calendar Widget -->
            <StackPanel x:Name="CalendarPanel" Visibility="Collapsed" Width="236">
                <Grid Margin="0,0,0,8">
                    <Button Style="{StaticResource GlassPillButton}" Padding="6,3" HorizontalAlignment="Left"
                            Click="CalWidgetMonth_Click" ToolTip="Jump to Today">
                        <TextBlock x:Name="CalWidgetMonthText" Text="November 2026" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource GlassTextPrimaryBrush}"/>
                    </Button>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource GlassPillButton}" Padding="7,2" Margin="0,0,3,0" Click="CalWidgetPrev_Click" ToolTip="Previous Month">
                            <TextBlock Text="&#xE76B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"/>
                        </Button>
                        <Button Style="{StaticResource GlassPillButton}" Padding="7,2" Click="CalWidgetNext_Click" ToolTip="Next Month">
                            <TextBlock Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <UniformGrid Columns="7" Margin="0,0,0,4">
                    <TextBlock Text="S" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource GlassTextSecondaryBrush}" TextAlignment="Center"/>
                    <TextBlock Text="M" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource GlassTextSecondaryBrush}" TextAlignment="Center"/>
                    <TextBlock Text="T" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource GlassTextSecondaryBrush}" TextAlignment="Center"/>
                    <TextBlock Text="W" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource GlassTextSecondaryBrush}" TextAlignment="Center"/>
                    <TextBlock Text="T" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource GlassTextSecondaryBrush}" TextAlignment="Center"/>
                    <TextBlock Text="F" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource GlassTextSecondaryBrush}" TextAlignment="Center"/>
                    <TextBlock Text="S" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource GlassTextSecondaryBrush}" TextAlignment="Center"/>
                </UniformGrid>

                <UniformGrid x:Name="CalWidgetDaysGrid" Columns="7"/>
            </StackPanel>

            <!-- 7. Reminders Widget -->
            <StackPanel x:Name="ReminderPanel" Visibility="Collapsed" Width="252">
                <Grid Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="REMINDERS" FontSize="10.5" FontWeight="SemiBold" Foreground="#FF0A84FF" VerticalAlignment="Center"/>
                        <Border Background="#280A84FF" CornerRadius="8" Padding="6,1" Margin="7,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="ReminderCountText" Text="0 left" FontSize="10" FontWeight="SemiBold" Foreground="#FF64D2FF"/>
                        </Border>
                    </StackPanel>
                    <Button x:Name="ClearDoneRemindersBtn" HorizontalAlignment="Right" Style="{StaticResource GlassPillButton}"
                            Padding="6,2" Visibility="Collapsed" Click="ClearDoneReminders_Click">
                        <TextBlock Text="Clear Done" FontSize="10"/>
                    </Button>
                </Grid>

                <ScrollViewer MaxHeight="168" VerticalScrollBarVisibility="Auto" Margin="0,0,0,6">
                    <StackPanel x:Name="ReminderItemsPanel"/>
                </ScrollViewer>

                <!-- Live Natural Language Parse Preview -->
                <Border x:Name="ReminderParsePreviewBorder" Visibility="Collapsed"
                        Background="#240A84FF" BorderBrush="#440A84FF" BorderThickness="1"
                        CornerRadius="7" Padding="8,4" Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE823;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="10.5" Foreground="#FF64D2FF" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="ReminderParsePreviewText" FontSize="10.5" FontWeight="Medium"
                                   Foreground="#FFE5F4FF" TextTrimming="CharacterEllipsis" MaxWidth="212"/>
                    </StackPanel>
                </Border>

                <Border Background="#1EFFFFFF" BorderBrush="{DynamicResource LiquidGlassRimBrush}" BorderThickness="1" CornerRadius="8" Padding="8,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <TextBlock x:Name="ReminderPlaceholder" Text="Type or speak a reminder..." FontSize="11.5"
                                       Foreground="{DynamicResource GlassTextMutedBrush}" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <TextBox x:Name="ReminderInputBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{DynamicResource GlassTextPrimaryBrush}"
                                     CaretBrush="{DynamicResource GlassTextPrimaryBrush}"
                                     FontFamily="Segoe UI Variable Text, Segoe UI"
                                     FontSize="12"
                                     VerticalContentAlignment="Center"
                                     Cursor="IBeam"
                                     PreviewMouseLeftButtonDown="NotesBox_PreviewMouseLeftButtonDown"
                                     TextChanged="ReminderInputBox_TextChanged"
                                     KeyDown="ReminderInputBox_KeyDown"/>
                        </Grid>
                        <Button x:Name="ReminderVoiceBtn" Grid.Column="1" Style="{StaticResource GlassPillButton}" Padding="7,3" Margin="4,0,0,0"
                                Click="ReminderVoice_Click" ToolTip="Speak a Reminder">
                            <TextBlock x:Name="ReminderVoiceIcon" Text="&#xE720;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11.5"/>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource GlassPillButton}" Padding="7,3" Margin="3,0,0,0"
                                Click="AddReminder_Click" ToolTip="Add Reminder">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"/>
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</Window>
