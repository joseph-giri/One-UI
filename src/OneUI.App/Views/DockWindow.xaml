<Window x:Class="OneUI.App.Views.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OneUI Dock"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Background="Transparent"
        MouseMove="Dock_MouseMove"
        MouseLeave="Dock_MouseLeave">

    <!-- Pure floating icons directly over the desktop with no surrounding box -->
    <Grid x:Name="DockRootGrid" Background="Transparent">
        <!-- Floating Tooltip Popup -->
        <Popup x:Name="TooltipPopup"
               AllowsTransparency="True"
               Placement="Relative"
               PlacementTarget="{Binding ElementName=DockRootGrid}"
               IsOpen="False"
               StaysOpen="True"
               PopupAnimation="Fade">
            <Border Background="{DynamicResource GlassTooltipBgBrush}"
                    BorderBrush="{DynamicResource LiquidGlassRimBrush}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="11,4"
                    Margin="6">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.38" Color="Black"/>
                </Border.Effect>
                <TextBlock x:Name="TooltipText"
                           Text=""
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="12"
                           FontWeight="Medium"
                           Foreground="{DynamicResource GlassTextPrimaryBrush}"/>
            </Border>
        </Popup>

        <!-- Multi-Window / Multi-Account Picker Flyout Popup -->
        <Popup x:Name="WindowPickerPopup"
               AllowsTransparency="True"
               Placement="Top"
               StaysOpen="False"
               PopupAnimation="Fade">
            <Border Background="{DynamicResource GlassMenuBgBrush}"
                    BorderBrush="{DynamicResource LiquidGlassRimBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="8"
                    Margin="10"
                    MinWidth="260"
                    MaxWidth="360">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.50" Color="Black"/>
                </Border.Effect>
                <StackPanel>
                    <Grid Margin="6,2,6,6">
                        <TextBlock x:Name="PickerHeaderText"
                                   Text="Open Windows"
                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource GlassTextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                        <Button HorizontalAlignment="Right"
                                Style="{StaticResource GlassPillButton}"
                                Padding="8,2"
                                Click="PickerNewWindow_Click"
                                ToolTip="Open a new window / instance">
                            <TextBlock Text="+ New Window" FontSize="11" FontWeight="SemiBold" Foreground="#FF0A84FF"/>
                        </Button>
                    </Grid>
                    <Separator Background="{DynamicResource GlassDividerBrush}" Margin="2,0,2,4"/>
                    <StackPanel x:Name="PickerItemsPanel"/>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Floating Icons Row (extra top headroom so magnified icons lift freely with zero clipping) -->
        <StackPanel x:Name="IconsPanel"
                    Orientation="Horizontal"
                    VerticalAlignment="Bottom"
                    Margin="18,26,18,8"/>
    </Grid>
</Window>
