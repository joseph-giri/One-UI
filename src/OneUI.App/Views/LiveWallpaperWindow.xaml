<Window x:Class="OneUI.App.Views.LiveWallpaperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OneUI Live Wallpaper"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Background="#FF080A12">

    <Grid x:Name="RootGrid" ClipToBounds="True">
        <!-- Custom Video Wallpaper Player -->
        <MediaElement x:Name="VideoPlayer"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Stop"
                      Stretch="UniformToFill"
                      IsMuted="True"
                      ScrubbingEnabled="False"
                      Visibility="Collapsed"
                      MediaOpened="VideoPlayer_MediaOpened"
                      MediaEnded="VideoPlayer_MediaEnded"
                      MediaFailed="VideoPlayer_MediaFailed"/>

        <!-- Built-in GPU-Accelerated Animated Liquid Glass Shaders -->
        <Grid x:Name="AnimatedShaderCanvas" Visibility="Visible">
            <Grid.Background>
                <LinearGradientBrush x:Name="BaseBackdropBrush" StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF070B18" Offset="0"/>
                    <GradientStop Color="#FF0E162B" Offset="0.5"/>
                    <GradientStop Color="#FF090C18" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <!-- Drifting Luminous Orb 1 -->
            <Ellipse x:Name="Orb1"
                     Width="900" Height="900"
                     HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="-180,-220,0,0"
                     Opacity="0.65">
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="Orb1Transform"/>
                </Ellipse.RenderTransform>
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#CC00E5FF" Offset="0"/>
                        <GradientStop Color="#550088FF" Offset="0.45"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Drifting Luminous Orb 2 -->
            <Ellipse x:Name="Orb2"
                     Width="980" Height="980"
                     HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Margin="0,0,-200,-240"
                     Opacity="0.62">
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="Orb2Transform"/>
                </Ellipse.RenderTransform>
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#CC7B2FFF" Offset="0"/>
                        <GradientStop Color="#4430D158" Offset="0.5"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Drifting Luminous Orb 3 -->
            <Ellipse x:Name="Orb3"
                     Width="780" Height="780"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Opacity="0.48">
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="Orb3Transform"/>
                </Ellipse.RenderTransform>
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#BB0A84FF" Offset="0"/>
                        <GradientStop Color="#33FF375F" Offset="0.55"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Grid>
    </Grid>
</Window>
