<Window x:Class="OneUI.App.Views.SpotlightWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick Search"
        Width="640"
        SizeToContent="Height"
        MaxHeight="520"
        Topmost="True"
        ShowInTaskbar="False"
        Background="Transparent"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border x:Name="RootCard"
            Background="{DynamicResource GlassSurfaceBrush}"
            BorderBrush="{DynamicResource LiquidGlassRimBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="0">
        <StackPanel>
            <!-- Search Input Row -->
            <Grid Margin="18,14,18,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="&#xE721;"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="20"
                           Foreground="{DynamicResource GlassTextSecondaryBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,14,0"/>

                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="PlaceholderText"
                               Text="Search apps, math (e.g. 24 * 16), or commands..."
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="20"
                               Foreground="{DynamicResource GlassTextSecondaryBrush}"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center"/>
                    <TextBox x:Name="QueryBox"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{DynamicResource GlassTextPrimaryBrush}"
                             CaretBrush="{DynamicResource GlassTextPrimaryBrush}"
                             FontFamily="Segoe UI Variable Display, Segoe UI"
                             FontSize="20"
                             VerticalAlignment="Center"
                             TextChanged="QueryBox_TextChanged"/>
                </Grid>

                <Border Grid.Column="2"
                        Background="#22FFFFFF"
                        CornerRadius="6"
                        Padding="7,3"
                        VerticalAlignment="Center">
                    <TextBlock Text="Alt+Space" FontSize="11" Foreground="{DynamicResource GlassTextSecondaryBrush}"/>
                </Border>
            </Grid>

            <!-- Results List -->
            <Border x:Name="ResultsContainer"
                    Visibility="Collapsed"
                    BorderBrush="{DynamicResource GlassDividerBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="8,8,8,10">
                <ListBox x:Name="ResultsList"
                         Background="Transparent"
                         BorderThickness="0"
                         MaxHeight="380"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="ResultsList_MouseDoubleClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="Margin" Value="2"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd"
                                                Background="Transparent"
                                                CornerRadius="12"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#24FFFFFF"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#550A84FF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Width="28" Height="28" VerticalAlignment="Center">
                                    <Image Source="{Binding Icon}" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock Text="{Binding Glyph}"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="17"
                                               Foreground="{DynamicResource GlassTextPrimaryBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Grid>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                                    <TextBlock Text="{Binding Title}"
                                               FontFamily="Segoe UI Variable Display, Segoe UI"
                                               FontSize="14.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource GlassTextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding Subtitle}"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource GlassTextSecondaryBrush}"/>
                                </StackPanel>

                                <TextBlock Grid.Column="2"
                                           Text="{Binding Badge}"
                                           FontSize="11"
                                           Foreground="{DynamicResource GlassTextSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="8,0,4,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
            <!-- Keyboard Shortcut Footer Bar -->
            <Border BorderBrush="{DynamicResource GlassDividerBrush}"
                    BorderThickness="0,1,0,0"
                    Background="#14000000"
                    CornerRadius="0,0,7,7"
                    Padding="16,7">
                <Grid>
                    <TextBlock Text="OneUI Quick Search" FontSize="11" Foreground="{DynamicResource GlassTextMutedBrush}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="↑↓ Navigate    ↵ Open    Esc Dismiss" FontSize="11" Foreground="{DynamicResource GlassTextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</Window>
