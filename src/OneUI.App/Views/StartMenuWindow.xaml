<Window x:Class="OneUI.App.Views.StartMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Start"
        Width="640"
        Height="660"
        Topmost="True"
        ShowInTaskbar="False"
        Background="Transparent"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- Flat hover-only tile/row button -->
        <Style x:Key="StartTileButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource GlassTextPrimaryBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3CFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pinned grid tile: large icon + centered label -->
        <DataTemplate x:Key="PinnedTileTemplate">
            <Button Style="{StaticResource StartTileButton}"
                    Padding="4,11,4,9"
                    Margin="2"
                    Click="AppTile_Click"
                    Tag="{Binding}"
                    ToolTip="{Binding Name}">
                <StackPanel Width="86" HorizontalAlignment="Center">
                    <Border Width="42" Height="42" CornerRadius="11"
                            Background="{Binding TileBrush}"
                            HorizontalAlignment="Center" Margin="0,0,0,8">
                        <Grid>
                            <Image Source="{Binding Icon}" Width="36" Height="36"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="{Binding FallbackGlyph}"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="20" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding Name}"
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               FontSize="11.5"
                               Foreground="{DynamicResource GlassTextPrimaryBrush}"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Center"
                               MaxWidth="82"/>
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- Single-line app row for All apps and Search -->
        <DataTemplate x:Key="AppRowTemplate">
            <Button Style="{StaticResource StartTileButton}"
                    Padding="10,7"
                    Margin="0,1"
                    HorizontalContentAlignment="Stretch"
                    Click="AppTile_Click"
                    Tag="{Binding}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" CornerRadius="8"
                            Background="{Binding TileBrush}"
                            HorizontalAlignment="Left">
                        <Grid>
                            <Image Source="{Binding Icon}" Width="26" Height="26"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="{Binding FallbackGlyph}"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="14" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding Name}"
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               FontSize="13"
                               Foreground="{DynamicResource GlassTextPrimaryBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Button>
        </DataTemplate>

        <!-- Recommended item: icon + name + time ago -->
        <DataTemplate x:Key="RecentRowTemplate">
            <Button Style="{StaticResource StartTileButton}"
                    Padding="10,8"
                    Margin="0,1"
                    HorizontalContentAlignment="Stretch"
                    Click="AppTile_Click"
                    Tag="{Binding}"
                    ToolTip="{Binding Name}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="8"
                            Background="{Binding TileBrush}"
                            HorizontalAlignment="Left">
                        <Grid>
                            <Image Source="{Binding Icon}" Width="28" Height="28"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="{Binding FallbackGlyph}"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="15" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}"
                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                   FontSize="12.5"
                                   Foreground="{DynamicResource GlassTextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Subtitle}"
                                   FontSize="10.5"
                                   Foreground="{DynamicResource GlassTextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="RootCard"
            Background="{DynamicResource GlassSurfaceBrush}"
            BorderBrush="{DynamicResource LiquidGlassRimBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Border CornerRadius="7"
                    Background="{StaticResource LiquidGlassLensGlowBrush}"
                    IsHitTestVisible="False"/>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Search -->
                <Border Grid.Row="0"
                        Background="{DynamicResource GlassCardBrush}"
                        BorderBrush="{DynamicResource LiquidGlassRimBrush}"
                        BorderThickness="1"
                        CornerRadius="20"
                        Padding="16,9"
                        Margin="28,24,28,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE721;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="14"
                                   Foreground="{DynamicResource GlassTextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,11,0"/>
                        <Grid Grid.Column="1">
                            <TextBlock x:Name="SearchPlaceholder"
                                       Text="Search for apps, settings, and documents"
                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                       FontSize="13.5"
                                       Foreground="{DynamicResource GlassTextSecondaryBrush}"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="SearchBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{DynamicResource GlassTextPrimaryBrush}"
                                     CaretBrush="{DynamicResource GlassTextPrimaryBrush}"
                                     FontFamily="Segoe UI Variable Text, Segoe UI"
                                     FontSize="13.5"
                                     VerticalAlignment="Center"
                                     TextChanged="SearchBox_TextChanged"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Content area: Home / All apps / Search -->
                <Grid Grid.Row="1">
                    <!-- HOME -->
                    <ScrollViewer x:Name="HomePanel" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="28,0,28,12">
                            <Grid Margin="6,0,2,6">
                                <TextBlock Text="Pinned"
                                           FontFamily="Segoe UI Variable Display, Segoe UI"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource GlassTextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                                <Button HorizontalAlignment="Right"
                                        Style="{StaticResource GlassPillButton}"
                                        Padding="10,4"
                                        Click="ShowAllApps_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="All apps" FontSize="11.5"
                                                   Foreground="{DynamicResource GlassTextPrimaryBrush}"/>
                                        <TextBlock Text="&#xE76C;"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="9" Margin="6,1,0,0"
                                                   Foreground="{DynamicResource GlassTextSecondaryBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <ItemsControl x:Name="PinnedItemsControl"
                                          ItemTemplate="{StaticResource PinnedTileTemplate}"
                                          Margin="0,0,0,10">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="6"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <StackPanel x:Name="RecommendedSection">
                                <TextBlock Text="Recommended"
                                           FontFamily="Segoe UI Variable Display, Segoe UI"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource GlassTextPrimaryBrush}"
                                           Margin="6,8,0,6"/>
                                <ItemsControl x:Name="RecentItemsControl"
                                              ItemTemplate="{StaticResource RecentRowTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ALL APPS (alphabetical with letter headers) -->
                    <Grid x:Name="AllAppsPanel" Visibility="Collapsed" Margin="28,0,28,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="2,0,2,6">
                            <Button HorizontalAlignment="Left"
                                    Style="{StaticResource GlassPillButton}"
                                    Padding="10,4"
                                    Click="BackToHome_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE76B;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="9" Margin="0,1,6,0"
                                               Foreground="{DynamicResource GlassTextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Back" FontSize="11.5"
                                               Foreground="{DynamicResource GlassTextPrimaryBrush}"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="All apps"
                                       FontFamily="Segoe UI Variable Display, Segoe UI"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource GlassTextPrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="AllAppsItemsControl"
                                          ItemTemplate="{StaticResource AppRowTemplate}">
                                <ItemsControl.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <Border Width="30" Height="30" CornerRadius="8"
                                                        Background="{DynamicResource GlassCardBrush}"
                                                        HorizontalAlignment="Left"
                                                        Margin="6,12,0,4">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="12.5" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource GlassTextSecondaryBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ItemsControl.GroupStyle>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- SEARCH RESULTS -->
                    <Grid x:Name="SearchPanel" Visibility="Collapsed" Margin="28,0,28,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="SearchHeaderText"
                                   Text="Best match"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource GlassTextPrimaryBrush}"
                                   Margin="6,0,0,6"/>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <ItemsControl x:Name="SearchItemsControl"
                                              ItemTemplate="{StaticResource AppRowTemplate}"/>
                                <TextBlock x:Name="NoResultsText"
                                           Visibility="Collapsed"
                                           Text="No matching apps found"
                                           FontSize="12.5"
                                           Foreground="{DynamicResource GlassTextSecondaryBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,30,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- Footer: profile + settings + power -->
                <Border Grid.Row="2"
                        Background="#18000000"
                        BorderBrush="{DynamicResource GlassDividerBrush}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,7,7"
                        Padding="26,12">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="34" Height="34" CornerRadius="17" Margin="0,0,11,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FF0A84FF" Offset="0"/>
                                        <GradientStop Color="#FF5E5CE6" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock x:Name="UserInitialText" Text="J"
                                           FontSize="14" FontWeight="SemiBold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="UserNameText" Text="Joseph"
                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource GlassTextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource GlassPillButton}" Padding="10,8"
                                    Click="OpenWinSettings_Click" ToolTip="Settings">
                                <TextBlock Text="&#xE713;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="14"/>
                            </Button>
                            <Button x:Name="PowerButton" Style="{StaticResource GlassPillButton}"
                                    Padding="10,8" Margin="2,0,0,0"
                                    Click="PowerButton_Click" ToolTip="Power">
                                <TextBlock Text="&#xE7E8;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="14"/>
                                <Button.ContextMenu>
                                    <ContextMenu x:Name="PowerMenu" Placement="Top" Closed="PowerMenu_Closed">
                                        <MenuItem Header="Lock" Click="Lock_Click"/>
                                        <MenuItem Header="Sleep" Click="Sleep_Click"/>
                                        <Separator/>
                                        <MenuItem Header="Restart" Click="Restart_Click"/>
                                        <MenuItem Header="Shut down" Click="Shutdown_Click"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
