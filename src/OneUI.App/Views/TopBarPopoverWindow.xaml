<Window x:Class="OneUI.App.Views.TopBarPopoverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OneUI Quick Tool"
        Width="310"
        SizeToContent="Height"
        Topmost="True"
        ShowInTaskbar="False"
        Background="Transparent"
        Deactivated="Window_Deactivated"
        KeyDown="Window_KeyDown">

    <Border x:Name="RootCard"
            Background="{DynamicResource GlassSurfaceBrush}"
            BorderBrush="{DynamicResource LiquidGlassRimBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="14">
        <Grid>
            <!-- 1. FOCUS / POMODORO TIMER -->
            <StackPanel x:Name="FocusPanel" Visibility="Collapsed">
                <Grid Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE916;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="#FF0A84FF" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock x:Name="FocusPhaseHeader" Text="FOCUS SESSION" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource GlassTextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Border Background="#240A84FF" CornerRadius="8" Padding="7,2" HorizontalAlignment="Right">
                        <TextBlock x:Name="FocusSessionCountText" Text="0 done" FontSize="10.5" FontWeight="SemiBold" Foreground="#FF64D2FF"/>
                    </Border>
                </Grid>

                <TextBlock x:Name="FocusBigTimeText"
                           Text="25:00"
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontSize="50"
                           FontWeight="Light"
                           TextAlignment="Center"
                           Foreground="{DynamicResource GlassTextPrimaryBrush}"
                           Margin="0,2,0,12"/>

                <UniformGrid Columns="2" Margin="0,0,0,12">
                    <Button x:Name="FocusStartPauseBtn" Style="{StaticResource GlassTileButton}" Background="#550A84FF" Padding="10,8" Margin="0,0,4,0" Click="FocusStartPause_Click">
                        <TextBlock x:Name="FocusStartPauseLabel" Text="Start Focus" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </Button>
                    <Button Style="{StaticResource GlassTileButton}" Padding="10,8" Margin="4,0,0,0" Click="FocusReset_Click">
                        <TextBlock Text="Reset" FontSize="12.5" FontWeight="Medium" HorizontalAlignment="Center"/>
                    </Button>
                </UniformGrid>

                <TextBlock Text="QUICK PRESETS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource GlassTextMutedBrush}" Margin="2,0,0,6"/>
                <UniformGrid Columns="4">
                    <Button Style="{StaticResource GlassPillButton}" Content="15m" Tag="Focus:15" Margin="0,0,4,0" Click="FocusPreset_Click"/>
                    <Button Style="{StaticResource GlassPillButton}" Content="25m" Tag="Focus:25" Margin="2,0" Click="FocusPreset_Click"/>
                    <Button Style="{StaticResource GlassPillButton}" Content="45m" Tag="Focus:45" Margin="2,0" Click="FocusPreset_Click"/>
                    <Button Style="{StaticResource GlassPillButton}" Content="5m Break" Tag="Break:5" Margin="4,0,0,0" Click="FocusPreset_Click"/>
                </UniformGrid>
            </StackPanel>

            <!-- 2. QUICK REMINDERS (TEXT + VOICE) -->
            <StackPanel x:Name="RemindersPanel" Visibility="Collapsed">
                <Grid Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="REMINDERS" FontSize="11" FontWeight="SemiBold" Foreground="#FF0A84FF" VerticalAlignment="Center"/>
                        <Border Background="#240A84FF" CornerRadius="8" Padding="6,1" Margin="7,0,0,0">
                            <TextBlock x:Name="PopReminderCount" Text="0 left" FontSize="10" FontWeight="SemiBold" Foreground="#FF64D2FF"/>
                        </Border>
                    </StackPanel>
                    <Button x:Name="PopClearDoneBtn" HorizontalAlignment="Right" Style="{StaticResource GlassPillButton}" Padding="6,2" Visibility="Collapsed" Click="PopClearDone_Click">
                        <TextBlock Text="Clear Done" FontSize="10"/>
                    </Button>
                </Grid>

                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
                    <StackPanel x:Name="PopReminderItemsPanel"/>
                </ScrollViewer>

                <Border x:Name="PopReminderPreviewBorder" Visibility="Collapsed"
                        Background="#240A84FF" BorderBrush="#440A84FF" BorderThickness="1"
                        CornerRadius="7" Padding="8,4" Margin="0,0,0,6">
                    <TextBlock x:Name="PopReminderPreviewText" FontSize="10.5" FontWeight="Medium"
                               Foreground="#FFE5F4FF" TextTrimming="CharacterEllipsis"/>
                </Border>

                <Border Background="#1EFFFFFF" BorderBrush="{DynamicResource LiquidGlassRimBrush}" BorderThickness="1" CornerRadius="8" Padding="8,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <TextBlock x:Name="PopReminderPlaceholder" Text="e.g. Drink water every 15 mins..." FontSize="11.5"
                                       Foreground="{DynamicResource GlassTextMutedBrush}" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <TextBox x:Name="PopReminderInput"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{DynamicResource GlassTextPrimaryBrush}"
                                     CaretBrush="{DynamicResource GlassTextPrimaryBrush}"
                                     FontSize="12"
                                     VerticalContentAlignment="Center"
                                     TextChanged="PopReminderInput_TextChanged"
                                     KeyDown="PopReminderInput_KeyDown"/>
                        </Grid>
                        <Button x:Name="PopVoiceBtn" Grid.Column="1" Style="{StaticResource GlassPillButton}" Padding="7,3" Margin="4,0,0,0" Click="PopVoice_Click" ToolTip="Speak a Reminder">
                            <TextBlock x:Name="PopVoiceIcon" Text="&#xE720;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11.5"/>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource GlassPillButton}" Padding="7,3" Margin="3,0,0,0" Click="PopAddReminder_Click" ToolTip="Add Reminder">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"/>
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- 3. CLIPBOARD HISTORY -->
            <StackPanel x:Name="ClipboardPanel" Visibility="Collapsed">
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="CLIPBOARD HISTORY" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource GlassTextSecondaryBrush}" VerticalAlignment="Center"/>
                    <Button HorizontalAlignment="Right" Style="{StaticResource GlassPillButton}" Padding="7,2" Click="ClearClipboard_Click">
                        <TextBlock Text="Clear Unpinned" FontSize="10"/>
                    </Button>
                </Grid>

                <Border Background="#1EFFFFFF" BorderBrush="{DynamicResource LiquidGlassRimBrush}" BorderThickness="1" CornerRadius="7" Padding="8,4" Margin="0,0,0,8">
                    <Grid>
                        <TextBlock x:Name="ClipSearchPlaceholder" Text="Filter clipboard..." FontSize="11.5" Foreground="{DynamicResource GlassTextMutedBrush}" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <TextBox x:Name="ClipSearchBox" Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource GlassTextPrimaryBrush}" CaretBrush="{DynamicResource GlassTextPrimaryBrush}"
                                 FontSize="12" TextChanged="ClipSearchBox_TextChanged"/>
                    </Grid>
                </Border>

                <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ClipboardItemsPanel"/>
                </ScrollViewer>
            </StackPanel>

            <!-- 4. QUICK SCRATCHPAD -->
            <StackPanel x:Name="ScratchpadPanel" Visibility="Collapsed">
                <Grid Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="QUICK SCRATCHPAD" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFD60A" VerticalAlignment="Center"/>
                        <TextBlock Text=" · Synced" FontSize="10" Foreground="{DynamicResource GlassTextMutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource GlassPillButton}" Padding="6,2" Margin="0,0,4,0" Click="CopyScratchpad_Click" ToolTip="Copy All">
                            <TextBlock Text="Copy" FontSize="10"/>
                        </Button>
                        <Button Style="{StaticResource GlassPillButton}" Padding="6,2" Click="ClearScratchpad_Click" ToolTip="Clear Note">
                            <TextBlock Text="Clear" FontSize="10"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <Border Background="#18FFFFFF" BorderBrush="{DynamicResource LiquidGlassRimBrush}" BorderThickness="1" CornerRadius="8" Padding="8">
                    <TextBox x:Name="ScratchpadBox"
                             Height="170"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{DynamicResource GlassTextPrimaryBrush}"
                             CaretBrush="{DynamicResource GlassTextPrimaryBrush}"
                             FontFamily="Segoe UI Variable Text, Segoe UI"
                             FontSize="12.5"
                             TextChanged="ScratchpadBox_TextChanged"/>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</Window>
